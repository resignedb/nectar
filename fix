local function bringPartToPlayer(partInstance)
    if not partInstance then return end
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local targetCF = hrp.CFrame * CFrame.new(0, 0, -5)
    pcall(function()
        if partInstance:IsA("Model") then partInstance:PivotTo(targetCF)
        else partInstance.CFrame = targetCF end
    end)
end

local secMyParts = tabParts:CreateSection("My Dropped Parts")
local droppedCountLbl = secMyParts:CreateLabel({ Text = "Parts Found  :  Scanning..." })

-- Built once, then refreshed in-place with the Dropdown:Refresh API.
local partsDropdown = secMyParts:CreateDropdown({
    Name = "Select Part", Values = {}, Flag = "parts_select",
    Callback = function(chosen)
        for _, pd in ipairs(myDroppedParts) do
            if pd.Name == chosen then selectedDroppedPart = pd.Instance break end
        end
    end,
})

local function refreshDroppedParts()
    myDroppedParts      = {}
    selectedDroppedPart = nil
    if not moveableParts then
        droppedCountLbl:Set("MoveableParts folder not found")
        return
    end
    for _, part in pairs(moveableParts:GetChildren()) do
        if tostring(part:GetAttribute("Owner")) == player.Name then
            table.insert(myDroppedParts, { Name = part.Name, Instance = part })
        end
    end
    droppedCountLbl:Set("Parts Found  :  " .. #myDroppedParts)
    local names = {}
    for _, pd in ipairs(myDroppedParts) do table.insert(names, pd.Name) end
    partsDropdown:Refresh(names, false)   -- rebuild dropdown values in place
end

secMyParts:CreateButton({
    Name = "Refresh Parts List", Description = "Scan MoveableParts for your dropped parts",
    Callback = function()
        refreshDroppedParts()
        notify("Dropped Parts", "Found " .. #myDroppedParts .. " part(s).")
    end,
})

