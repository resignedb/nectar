local function updateLiveCarStatus()
    local currentMoney = findMoney()
    for i = 1, 9 do liveCarStatuses[i] = { Text = "[Empty Slot]", Instance = nil } end

    local slotIndex = 1
    for _, car in pairs(vehiclesFolder:GetChildren()) do
        if slotIndex > 9 then break end
        local owner    = car:GetAttribute("Owner") or car:FindFirstChild("Owner")
        local hasOwner = owner and tostring(owner) ~= "" and tostring(owner) ~= "0"
        local spawnChance = tonumber(car:GetAttribute("SpawnChance"))

        if not hasOwner and spawnChance then
            local carName  = car.Name
            local maxPrice = getSecondPrice(car) or 0
            local reason
            if car:GetAttribute("ExclusivePrice") then
                reason = "Exclusive"
            elseif not getgenv().AutobuyEnabled then
                reason = "Sniper Off"
            elseif spawnChance > getgenv().SpawnChanceLimit then
                reason = "Chance Skip"
            elseif currentMoney < maxPrice then
                reason = "No Funds"
            else
                reason = "BUYING!"
            end
            liveCarStatuses[slotIndex] = {
                Text     = carName .. "  $" .. tostring(maxPrice) .. "  [" .. reason .. "]",
                Instance = car,
            }
            slotIndex = slotIndex + 1

            if webhookAlertEnabled and not webhookNotified[car]
                and not car:GetAttribute("ExclusivePrice")
                and spawnChance <= webhookChanceLimit then
                webhookNotified[car] = true
                sendCarAlert(carName, maxPrice, spawnChance, currentTimerValue)
            end
        end
    end
end

local function applyESP()
    for _, v in pairs(vehiclesFolder:GetChildren()) do
        if not getgenv().EspEnabled or not isRealCar(v) then
            if v:FindFirstChild("ESPHighlight") then v.ESPHighlight:Destroy() end
            if v:FindFirstChild("ESPGui")       then v.ESPGui:Destroy()       end
            continue
        end
        local chance = tonumber(v:GetAttribute("SpawnChance"))
        if chance and chance > 0 and chance <= 1 and not notifiedVehicles[v] then
            playAlertSound()
            sendRobloxNotification("Rare Car Spawned", "Chance: " .. tostring(chance) .. "%", 5)
            notifiedVehicles[v] = true
        end
        local hl = v:FindFirstChild("ESPHighlight") or Instance.new("Highlight", v)
        hl.Name                = "ESPHighlight"
        hl.FillColor           = (chance and chance <= 1) and Color3.new(1,0,0) or Color3.new(1,1,1)
        hl.FillTransparency    = (chance and chance <= 1) and 0.2 or 1
        hl.OutlineTransparency = 0.7
        local bill = v:FindFirstChild("ESPGui") or Instance.new("BillboardGui", v)
        bill.Name        = "ESPGui"
        bill.AlwaysOnTop = true
        bill.Size        = UDim2.new(0, 100, 0, 40)
        bill.StudsOffset = Vector3.new(0, 6, 0)
        local lab = bill:FindFirstChild("TextLabel") or Instance.new("TextLabel", bill)
        lab.BackgroundTransparency = 1
        lab.Size       = UDim2.new(1, 0, 1, 0)
        lab.TextColor3 = Color3.new(1, 1, 1)
        lab.Font       = Enum.Font.GothamBold
        lab.RichText   = true
        local col = (chance and chance <= 1) and "rgb(255,0,0)" or "rgb(0,255,128)"
        lab.Text  = "Body\n<font color='"..col.."'>" .. (chance or "?") .. "%</font>"
    end
end

