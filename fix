local bv, bg
RunService.RenderStepped:Connect(function()
    local character = player.Character
    local humanoid  = character and character:FindFirstChildWhichIsA("Humanoid")
    if getgenv().VehicleFlyEnabled and humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
        local seat = humanoid.SeatPart
        if not bv or bv.Parent ~= seat then
            bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Parent   = seat
        end
        if not bg or bg.Parent ~= seat then
            bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.P         = 9e4
            bg.Parent    = seat
        end
        local cam   = Workspace.CurrentCamera
        local speed = getgenv().VehicleFlySpeed
        local F = UserInputService:IsKeyDown(Enum.KeyCode.W)         and  1 or 0
        local B = UserInputService:IsKeyDown(Enum.KeyCode.S)         and -1 or 0
        local L = UserInputService:IsKeyDown(Enum.KeyCode.A)         and -1 or 0
        local R = UserInputService:IsKeyDown(Enum.KeyCode.D)         and  1 or 0
        local Q = (UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space))     and  2 or 0
        local E = (UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)) and -2 or 0
        if (L+R) ~= 0 or (F+B) ~= 0 or (Q+E) ~= 0 then
            bv.Velocity = ((cam.CFrame.LookVector * (F+B)) + ((cam.CFrame * CFrame.new(L+R, (F+B+Q+E)*0.2, 0).Position) - cam.CFrame.Position)) * speed
        else
            bv.Velocity = Vector3.new(0, 0, 0)
        end
        local _, yaw, _ = cam.CFrame:ToEulerAnglesYXZ()
        bg.CFrame = CFrame.fromEulerAnglesYXZ(0, yaw, 0)
    else
        if bv then bv:Destroy() bv = nil end
        if bg then bg:Destroy() bg = nil end
    end
end)

