-- ============================================================================
-- AUTOBUY
-- ============================================================================
local function processAutobuy()
    if not getgenv().AutobuyEnabled then return end
    local currentMoney = findMoney()
    local validCars    = {}
    for _, car in pairs(vehiclesFolder:GetChildren()) do
        if isRealCar(car) and not car:GetAttribute("Owner") then
            local spawnChance = tonumber(car:GetAttribute("SpawnChance")) or 100
            if spawnChance <= getgenv().SpawnChanceLimit then
                local maxPrice = getSecondPrice(car)
                if maxPrice and currentMoney >= maxPrice then
                    table.insert(validCars, { Instance = car, Chance = spawnChance, Price = maxPrice })
                end
            end
        end
    end
    table.sort(validCars, function(a, b) return a.Chance < b.Chance end)
    for _, carData in ipairs(validCars) do
        local car = carData.Instance
        local cd  = car:FindFirstChildWhichIsA("ClickDetector", true) or car:FindFirstChild("ClickDetector")
        if cd then
            local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if hrp and car:IsA("Model") then
                hrp.CFrame = CFrame.new(car:GetPivot().Position + Vector3.new(0, 4, 2))
            end
            for _ = 1, 5 do
                fireclickdetector(cd, 1)
                fireclickdetector(cd, 0)
            end
            task.spawn(function()
                local hud       = playerGui:WaitForChild("HUD", 4)
                local frames    = hud and hud:WaitForChild("Frames", 4)
                local confFrame = frames and frames:WaitForChild("Confirmation", 4)
                local confBtn   = confFrame and confFrame:WaitForChild("Confirm", 4)
                if confFrame and confBtn then
                    local attempts = 0
                    while confFrame.Visible and attempts < 40 do
                        attempts = attempts + 1
                        for _, sig in pairs(getconnections(confBtn.Activated))         do sig:Fire() end
                        for _, sig in pairs(getconnections(confBtn.MouseButton1Click)) do sig:Fire() end
                        pcall(function()
                            local ap  = confBtn.AbsolutePosition
                            local as_ = confBtn.AbsoluteSize
                            local cx  = ap.X + as_.X / 2
                            local cy  = ap.Y + as_.Y / 2 + 36
                            local vim = game:GetService("VirtualInputManager")
                            vim:SendMouseButtonEvent(cx, cy, 0, true,  game, 0)
                            vim:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
                        end)
                        task.wait(0.05)
                    end
                    if not confFrame.Visible and attempts < 40 then
                        carsBoughtCount = carsBoughtCount + 1
                        sendBuyAlert(car.Name, carData.Price)
                    end
                end
            end)
            break
        end
    end
end

