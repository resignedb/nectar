-- Nectar notifications use a table signature; wrap it so the rest of the file
-- reads like the old Window:Notify(title, text) calls.
local function notify(title, content, kind, duration)
    Nectar:Notify({
        Title    = title,
        Content  = content,
        Type     = kind or "Info",
        Duration = duration or 4,
    })
end

local function sendRobloxNotification(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", { Title = title, Text = text, Duration = duration or 5 })
    end)
end

local function playAlertSound()
    local sound = Instance.new("Sound")
    sound.Parent  = playerGui
    sound.SoundId = "rbxassetid://" .. AlertSoundID
    sound.Volume  = SoundVolume
    sound:Play()
    task.delay(5, function() sound:Destroy() end)
end

local function findMoney()
    if not moneyObject then
        local pd   = player:FindFirstChild("PlayerData")
        local stat = pd and pd:FindFirstChild("Status")
        moneyObject = stat and stat:FindFirstChild("Money")
    end
    if moneyObject then
        local parsed = tonumber(tostring(moneyObject.Value):gsub("[^%d%.]", ""))
        if parsed then liveParsedWallet = parsed return parsed end
    end
    return liveParsedWallet or 0
end

local function getSecondPrice(carInstance)
    local priceAttr = carInstance:GetAttribute("Price")
    if not priceAttr then return nil end
    if type(priceAttr) == "table" then
        return tonumber(priceAttr.Max or priceAttr.max)
    end
    local ok, res = pcall(function() return priceAttr.Max or priceAttr.max or priceAttr.Y end)
    if ok and tonumber(res) then return tonumber(res) end
    return tonumber(tostring(priceAttr):gsub("[^%d%.]", ""))
end

local function isRealCar(v)
    if v:GetAttribute("ExclusivePrice") then return false end
    local chance = tonumber(v:GetAttribute("SpawnChance"))
    if not chance then return false end
    local owner    = v:GetAttribute("Owner") or v:FindFirstChild("Owner")
    local hasOwner = owner and tostring(owner) ~= "" and tostring(owner) ~= "0"
    if chance <= 0 or hasOwner then return false end
    return true
end

local function findPlayerCar()
    for _, car in pairs(vehiclesFolder:GetChildren()) do
        if tostring(car:GetAttribute("Owner")) == player.Name then return car end
    end
    return nil
end

local function teleportToCar(carInstance)
    if not carInstance or not carInstance:IsA("Model") then return end
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.new(carInstance:GetPivot().Position + Vector3.new(0, 4, 6))
        sendRobloxNotification("Teleport", "Teleported to " .. carInstance.Name, 2)
    end
end

local function teleportCarOrPlayer(targetPos)
    local character = player.Character
    local humanoid  = character and character:FindFirstChildWhichIsA("Humanoid")
    if humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
        local seat  = humanoid.SeatPart
        local model = seat:FindFirstAncestorOfClass("Model") or seat.Parent
        if model then
            model:PivotTo(CFrame.new(targetPos + Vector3.new(0, 3, 0)))
        else
            seat.AssemblyLinearVelocity  = Vector3.new(0, 0, 0)
            seat.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            seat.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
        end
    else
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0)) end
    end
end

