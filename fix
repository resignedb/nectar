local function getTuneChanges(carInstance)
    local chassisScript = carInstance:FindFirstChild("A-Chassis Tune")
    if not chassisScript then return nil end
    local config = chassisScript:FindFirstChild("Configuration") or chassisScript:FindFirstChild("TuneChanges")
    if config and config.Name ~= "TuneChanges" then
        return config:FindFirstChild("TuneChanges")
    end
    return config
end

local function buildTuneControls(tuneFolder)
    secTune:Clear()               -- ADDED library feature: wipe old controls cleanly
    tuneNumberHandles = {}
    tuneBoolHandles   = {}

    local children = tuneFolder:GetChildren()
    table.sort(children, function(a, b) return a.Name < b.Name end)

    local built = 0
    for _, val in ipairs(children) do
        local cn = val.ClassName
        if cn == "BoolValue" then
            local boundVal = val
            -- Prechecked: Default = the value's live state.
            local h = secTune:CreateToggle({
                Name = boundVal.Name, Default = boundVal.Value == true,
                Callback = function(state) pcall(function() boundVal.Value = state end) end,
            })
            table.insert(tuneBoolHandles, { handle = h, val = boundVal })
            built += 1
        elseif cn == "NumberValue" or cn == "IntValue" then
            local boundVal = val
            local h = secTune:CreateNumberInput({
                Name = boundVal.Name, Default = boundVal.Value, Step = 1,
                Callback = function(n) pcall(function() boundVal.Value = n end) end,
            })
            -- ADDED library feature: the description line becomes a live readout
            -- of the value's current in-game number.
            h:SetDescription("current: " .. tostring(boundVal.Value))
            table.insert(tuneNumberHandles, { handle = h, val = boundVal })
            built += 1
        end
    end

    if built == 0 then
        secTune:CreateLabel({ Text = "This car exposes no tunable A-Chassis values.", Muted = true })
    end
end

