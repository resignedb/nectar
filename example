--═══════════════════════════ 8.5 · ADDED features (Mango build) ════════
--[[
	Three additions layered onto Nectar for the Mango port:

	  1. handle:SetDescription(text)  — every Row-based control (Button, Toggle,
	     Slider, Textbox, NumberInput, Dropdown, Keybind) can now show/refresh a
	     description line AT RUNTIME, even if it was created without one. Used as
	     a live data readout under a control.
	  2. handle:SetTitle(text)       — readable alias for the existing SetName.
	  3. Section:Clear()             — destroy every control in a section (but
	     keep the section) so it can be rebuilt on the fly. Also
	     Section:GetElements() returns the live { Name, Handle } list.
]]
local AddedLive = AddedTab:CreateSection("Live description readout")

-- A NumberInput created WITHOUT a Description that grows one live. This is the
-- exact pattern the Mango "Performance Mods" tab uses to display each
-- A-Chassis tune value's current in-game number under its input.
local tuneInput = AddedLive:CreateNumberInput({
	Name = "Boost PSI", Min = 0, Max = 30, Step = 1, Default = 12,
	Callback = function(n)
		print("[Added] Boost PSI →", n)
	end,
})
tuneInput:SetDescription("current: 12")     -- lazily adds the description line

-- A Textbox whose label (title) AND description both update from data.
local nameInput = AddedLive:CreateTextbox({
	Name = "Profile Name", Placeholder = "type a name…",
	Callback = function(text)
		nameInput:SetTitle(text == "" and "Profile Name" or ("Profile: " .. text)) -- SetTitle alias
		nameInput:SetDescription(text == "" and nil or ("saved as \"" .. text .. "\""))
		print("[Added] profile →", text)
	end,
})

-- drive the NumberInput's description from its own live value every 0.5s
task.spawn(function()
	while task.wait(0.5) do
		pcall(function()
			tuneInput:SetDescription("current: " .. tostring(tuneInput:Get()))
		end)
	end
end)

local AddedRebuild = AddedTab:CreateSection("Section:Clear() rebuild")
AddedRebuild:CreateLabel({ Text = "Press to regenerate the controls below.", Muted = true })

local dynHost = AddedTab:CreateSection("Dynamic controls")
local rebuildCount = 0
local function rebuildDynamic()
	dynHost:Clear()                                   -- wipe old controls cleanly
	rebuildCount += 1
	local n = math.random(2, 4)
	dynHost:CreateLabel({ Text = string.format("Rebuild #%d — generated %d toggles", rebuildCount, n) })
	for i = 1, n do
		local default = math.random() > 0.5
		dynHost:CreateToggle({                         -- prechecked via Default
			Name = "Auto module " .. i,
			Description = default and "starts ON" or "starts OFF",
			Default = default,
			Callback = function(v) print(string.format("[Added] module %d → %s", i, tostring(v))) end,
		})
	end
	print("[Added] section now holds", #dynHost:GetElements(), "controls") -- GetElements
end
rebuildDynamic()
AddedRebuild:CreateButton({
	Name = "Rebuild dynamic controls",
	Callback = rebuildDynamic,
})

